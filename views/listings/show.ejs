<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2><%=data.title%></h2>
        </div>
          <!-- <h2><%=data.title%></h2> -->
    <div class="card col-6 offset-2">
     <img src="<%=data.image%>" class="card-img-top showimg " alt="listing img">
     <div class="card-body">
       <!-- <h5 class="card-title">Card title</h5> -->
         <p><b><%=data.title%></b><br>
          <%=data.description%><br>
          &#8377;<%=data.price.toLocaleString("en-IN")%><br>
       <%=data.location%><br>
       <%=data.country%>
         </p>
      
    </div>
    </div>
     <!-- <ul>
       <li><%=data.title%></li>
       <li><%=data.description%></li>
       <li><%=data.price%></li>
       <li><%=data.location%></li>
       <li><%=data.country%></li>
    </ul> -->
    </div>
    <div class="btns d-flex  col-3 offset-2 gap-5">
        <div class="btn1 ">
    <form method="GET" action="/listing/<%=data.id%>/edit" > 
        <button class="edit-btn rounded"> Edit </button>
    </form>
    </div>
    <div class="btn2 ">    <form method="POST" action="/listing/<%=data.id%>?_method=DELETE">
        <button class="del-btn rounded ">Delete</button>
    </form>
    </div>
    </div>
<hr/>
<form action="/listing/<%=data.id%>/reviews" method="POST">
<div class="mt-3 mb-3">
    <h4> Leave a Review</h4>
    <label for="range2" class="form-label" name="reviews[rating]">Rating</label>
    <input type="range" class="form-range" min="0" max="5" id="range2">
    <div class="mt-3 mb-3">
        <label for="comment">Comments</label><br>
        <textarea id="comment"  name="reviews[comment]" cols="30" rows="5" class="form-control"></textarea>
    </div>
    <button class="btn btn-outline-dark">submit</button>
</div>
</form>