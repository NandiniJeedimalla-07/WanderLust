<% layout("/layouts/boilerplate") -%>
<h2><%=success%></h2>

    <!-- <form method="GET" action="/listings/new">
        <button>Create a new listing </button>
    </form> -->
    <style>
        #filters{
            display:flex;
            flex-wrap:wrap;
            align-items:center;
        }
        .filter{
            text-align:center;
            margin-right:2rem;
            margin-top:2rem;
            opacity:0.7;
        }
        
        .filter:hover{
            opacity:1;
            cursor:pointer;
        }

        .filter p{
            font-size:0.8rem;
        }

        #tax-info{
            display:none';
        }
        .toggle{
            border:1px solid black ;
            border-radius:1rem;
            height:3.5rem;
            padding: 1rem;
            margin-left:5rem;
            display:flex;
            align-items:center;
        }
    </style>
<div id="filters">
    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-hotel"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-seedling"></i></div>
        <p>Farms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </div>


    <div class="toggle filter">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault"> total after taxes</label>
        </div>
    </div>

</div>
<div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
 <% for(let lis of allListing) {%>
    <a href="/listing/<%=lis.id%>">
    <div class="card listing-card">
    <img src="<%=lis.image.url %>" class="card-img-top" alt="..." style="height:20rem">
        <div class="card-img-overlay" Style="color:brown"></div>
     <div class="card-body">
    <p class="card-text">
       <b><%=lis.title%></b><br>
        &#8377; <%=lis.price.toLocaleString("en-IN") %> /night 
         <i class="tax-info">+18% GST</i>  
    </p>
    </div>
    </div>
    </a>
 <%}%>
 </div>

<script>
    let taxswitch=document.gerElementById("switchCheckDefault");
    taxswitch.addEventListener("click",()=>{
       let taxInfo=document.getElementByClassName("tax-info");
       for(info of taxInfo){
        if(info.style.dispaly!="inline"){
        info.style.display="inline";
       }
       else{
        info.style.display="none";   
       }   
    } 
    });

</script>
    